# ChaosPay — пример переменных окружения.
# Скопируй в .env (`cp .env.example .env`) и подкрути под свой инстанс PG.
# .env уже в .gitignore — реальные значения в репо не утекут.

# Глобальная задержка ответов (в секундах) для имитации тормозов банка.
CHAOSPAY_DELAY_SECONDS=0

# ----- QR-PAY -----
PG_WEBHOOK_URL=http://payment-gateway-go-nginx:80/api/v1/payment-gateway/webhook/freedom-qr

# ----- Freedom Pay (карточные) -----
# Webhook PG для оплат
PG_FREEDOM_PAY_WEBHOOK_URL=http://payment-gateway-go-nginx:80/api/v1/payment-gateway/webhook/freedompay
# Webhook PG для bind-карты
PG_FREEDOM_PAY_CARD_WEBHOOK_URL=http://payment-gateway-go-nginx:80/api/v1/payment-gateway/webhook/freedompay/card
# Должны совпадать с freedompay_merchant_id / freedompay_merchant_secret тестового терминала в БД PG.
CHAOSPAY_FREEDOM_MERCHANT_ID=100001
CHAOSPAY_FREEDOM_SECRET=mock-secret-key
# Внутренний номер терминала в моке (не связан с db.id терминала PG).
CHAOSPAY_FREEDOM_TERMINAL_ID=1
# true — мок автоматически шлёт webhook на каждый переход в Authorized/Captured/...
# false — webhook отправляется кнопкой Send Webhook из панели (для воспроизведения EX-1001 лучше false).
CHAOSPAY_FREEDOM_AUTO_WEBHOOK=false
# URL hosted-формы (редирект после init_payment.php). В моке — наша же панель.
CHAOSPAY_FREEDOM_HOSTED_URL=http://localhost:48532/panel?bank=freedom&tab=cards

# ----- Halyk Epay v2 -----
# OAuth client (любая из тестовых пар Halyk: test/test1/test2/test3).
CHAOSPAY_EPAY_CLIENT_ID=test
CHAOSPAY_EPAY_CLIENT_SECRET=yF587AV9Ms94qN2QShFzVR3vFnWkhjbAK3sG
# UUID терминала (должен совпадать с конфигом терминала Epay v2 в БД PG).
CHAOSPAY_EPAY_TERMINAL_UUID=67e34d63-102f-4bd1-898e-370781d0074d
# Postlink URLs PG.
PG_EPAY_POSTLINK_URL=http://payment-gateway-go-nginx:80/api/v1/payment-gateway/webhook/epay_v2/postlink
PG_EPAY_FAILURE_POSTLINK_URL=http://payment-gateway-go-nginx:80/api/v1/payment-gateway/webhook/epay_v2/failure_postlink
PG_EPAY_BIND_POSTLINK_URL=http://payment-gateway-go-nginx:80/api/v1/payment-gateway/webhook/epay/postlink/bind
# true — мок автоматически шлёт postlink после успешного charge/cancel/refund.
CHAOSPAY_EPAY_AUTO_WEBHOOK=false

# ----- Freedom Loyalty -----
# Процент кешбека: cashbackAmount = amount * percent / 100.
CHAOSPAY_LOYALTY_CASHBACK_PERCENT=10
# Фиксированный остаток баланса клиента во Freedom.
CHAOSPAY_LOYALTY_CASHBACK_BALANCE=10000
